# ============================================================
# MediaWiki Docker — environment configuration
# Copy this file to .env and fill in the required values.
# ============================================================

# ------------------------------------------------------------
# MediaWiki version
# Must match an official image tag: https://hub.docker.com/_/mediawiki/tags
# Set automatically by import-from-softaculous.sh when importing a backup.
# ------------------------------------------------------------
MEDIAWIKI_VERSION=1.42

# ------------------------------------------------------------
# Port to expose MediaWiki on the host
# ------------------------------------------------------------
# HTTP_PORT=80

# ------------------------------------------------------------
# Compose project name — controls container and volume naming.
# Allows multiple wiki instances on the same host.
# Defaults to mw-{version}-{port} when set by the import script.
# ------------------------------------------------------------
# COMPOSE_PROJECT_NAME=mw-1.42-8080

# ------------------------------------------------------------
# Database — required, no defaults
# MYSQL_ROOT_PASSWORD : used internally by MariaDB only
# MYSQL_PASSWORD      : password for the mediawiki DB user
# Set automatically by import-from-softaculous.sh when importing a backup.
# ------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ------------------------------------------------------------
# Database — optional, defaults shown
# Set automatically by import-from-softaculous.sh when importing a backup.
# ------------------------------------------------------------
# MYSQL_DATABASE=mediawiki
# MYSQL_USER=mediawiki

# ------------------------------------------------------------
# MariaDB version
# Check requirements for your MediaWiki version:
# https://www.mediawiki.org/wiki/Compatibility#Database
# Set automatically by import-from-softaculous.sh when importing a backup.
# ------------------------------------------------------------
# MARIADB_VERSION=10.11
